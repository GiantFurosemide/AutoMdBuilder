manifest {
    name = 'GiantFurosemide/AutoMdBuilder'
    version = '0.1.0'
    mainScript = 'main.nf'
    nextflowVersion = '!>=24.10.4'
}
params {
    samples = null
    outdir = 'results'
    forcefield = 'amber99sb-ildn'
    water = 'tip3p'
    padding_nm = 1.2
    salt_molar = 0.15
    temperature_k = 303.15
    nvt_ps = 500.0
    npt_ps = 500.0
    dt_ps = 0.002
    em_steps = 50000
    em_tolerance = 1000.0
    seed = 20241126
    cpus = 8
    memory = '16 GB'
    time = '12h'
    partition = 'gpu'
    gpu_gres = 'gpu:a40:1'
    queue_size = 100
    gmx = 'gmx'
    gpu = false
    gmx_container = null
    acpype_container = null
    mdp_dir = "${projectDir}/assets/mdp"
    help = false
}
process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 1
    memory = { params.memory }
    time = { params.time }
    cache = 'deep'
    // Retry only resource/preemption failures; chemistry/input errors are not retried.
    errorStrategy = { task.exitStatus in [137, 140, 143] && task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries = 2
    withLabel: dynamics {
        cpus = { params.cpus }
    }
}
workflow.failOnIgnore = true
profiles {
    slurm { includeConfig 'conf/slurm.config' }
    local_gpu { includeConfig 'conf/local_gpu.config' }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = '--nv'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '--gpus all'
    }
    standard { }
    test {
        params.gpu = false
        params.cpus = 1
        params.memory = '1 GB'
        params.time = '10m'
        executor.queueSize = 1
    }
}
// Queue size 1 also prevents overlap between DIFFERENT process types locally.
executor.$local.queueSize = 1
def reportStamp = new Date().format('yyyyMMdd_HHmmss_SSS')
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/${reportStamp}.trace.tsv"
    overwrite = false
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,workdir'
}
report { enabled = true; file = "${params.outdir}/pipeline_info/${reportStamp}.report.html"; overwrite = false }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/${reportStamp}.timeline.html"; overwrite = false }
dag { enabled = true; file = "${params.outdir}/pipeline_info/${reportStamp}.dag.html"; overwrite = false }
