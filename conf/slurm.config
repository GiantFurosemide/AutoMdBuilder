params.gpu = true
process {
    executor = 'slurm'
    queue = { params.partition }
    withLabel: dynamics {
        cpus = { params.cpus }
        clusterOptions = { "--gres=${params.gpu_gres}" }
    }
}
executor {
    queueSize = params.queue_size
    submitRateLimit = '10 sec'
    pollInterval = '30 sec'
    queueStatInterval = '1 min'
}
