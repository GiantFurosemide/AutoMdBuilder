; Restrained, isotropic aqueous equilibration. Not suitable for a lipid bilayer.
integrator = md
dt = @dt_ps@
nsteps = @npt_steps@
define = -DPOSRES
continuation = yes
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 4
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
DispCorr = EnerPres
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = @temperature_k@
ld-seed = @seed@
pcoupl = C-rescale
pcoupltype = isotropic
tau-p = 5.0
ref-p = 1.0
compressibility = 4.5e-5
refcoord-scaling = com
gen-vel = no
pbc = xyz
nstenergy = 500
nstlog = 500
nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 0
