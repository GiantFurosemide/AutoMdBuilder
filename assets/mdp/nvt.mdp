; Initial restrained equilibration. Seeds are derived from case_id/replica/base seed.
integrator = md
dt = @dt_ps@
nsteps = @nvt_steps@
define = -DPOSRES
continuation = no
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 4
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
DispCorr = EnerPres
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = @temperature_k@
ld-seed = @seed@
pcoupl = no
gen-vel = yes
gen-temp = @temperature_k@
gen-seed = @seed@
pbc = xyz
nstenergy = 500
nstlog = 500
nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 0
